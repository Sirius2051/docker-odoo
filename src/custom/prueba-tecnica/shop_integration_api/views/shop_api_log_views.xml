<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shop_api_log_view_tree" model="ir.ui.view">
        <field name="name">shop.api.log.tree</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-danger="status_code &gt;= 400">
                <field name="create_date" string="Fecha"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="user_id"/>
                <field name="status_code"/>
                <field name="error_code"/>
                <field name="duration_ms"/>
                <field name="order_id"/>
            </tree>
        </field>
    </record>

    <record id="shop_api_log_view_search" model="ir.ui.view">
        <field name="name">shop.api.log.search</field>
        <field name="model">shop.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="user_id"/>
                <filter name="failed" string="Fallidas" domain="[('status_code', '&gt;=', 400)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_error" string="Código de error" context="{'group_by': 'error_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_api_log_action" model="ir.actions.act_window">
        <field name="name">Llamadas a la API de la tienda</field>
        <field name="res_model">shop.api.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="shop_api_log_menu"
              name="API de la tienda"
              parent="sale.menu_sale_config"
              action="shop_api_log_action"
              groups="sales_team.group_sale_manager"
              sequence="90"/>
</odoo>